# Copy to .env and fill in DB_PASSWORD (A-Za-z0-9 only). .env is gitignored.
IMMICH_VERSION=v3.2.2

# All persistent state lives under one directory on a local disk (not NFS).
UPLOAD_LOCATION=/mnt/data/immich-poc/library
DB_DATA_LOCATION=/mnt/data/immich-poc/postgres
MODEL_CACHE_LOCATION=/mnt/data/immich-poc/model-cache

TZ=America/Chicago

DB_PASSWORD=CHANGEME
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
