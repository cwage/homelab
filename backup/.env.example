# Backup Tooling Configuration
# Copy this file to .env and fill in values as needed
# This .env file is gitignored for security

# =============================================================================
# OpenBao connection (workstation rclone shell — periodic token)
# =============================================================================
# Production runs through openbao-agent's AppRole on containers; this token
# is exclusively for ad-hoc workstation runs. Generate via:
#   bao token create -policy=backup-remote -no-default-policy -orphan \
#                    -period=8760h -display-name=backup-remote
# and store under kv/backup/remote-token (see backup/README.md).

BAO_ADDR=https://bao.lan.quietlife.net:8200
BAO_TOKEN=your_backup_remote_token_here

# TLS certificate verification is ENABLED by default (BAO_SKIP_VERIFY unset).
# Uncomment below only for temporary bootstrap or local testing when you
# cannot yet trust the OpenBao TLS certificate.
# BAO_SKIP_VERIFY=true

# =============================================================================
# Notifications (ntfy.sh)
# =============================================================================
# Full URL to the ntfy topic for backup notifications.
# Leave empty or unset to disable notifications.

# NTFY_TOPIC=https://ntfy.sh/your-topic-here

# =============================================================================
# Direct B2 Credentials (Fallback / Local Development)
# =============================================================================
# If BAO_ADDR and BAO_TOKEN are set above, the entrypoint fetches credentials
# from OpenBao and these are ignored. Uncomment and fill in only if you need
# to run without OpenBao (e.g., local testing without access to the bao VM).

# RCLONE_CONFIG_B2_TYPE=b2
# RCLONE_CONFIG_B2_ACCOUNT=your_account_id_here
# RCLONE_CONFIG_B2_KEY=your_application_key_here
# RCLONE_CONFIG_B2CRYPT_TYPE=crypt
# RCLONE_CONFIG_B2CRYPT_REMOTE=b2:cwagenas-backup
# RCLONE_CONFIG_B2CRYPT_PASSWORD=your_crypt_password_here
# Do NOT set RCLONE_CONFIG_B2CRYPT_PASSWORD2 — production omits the salt
# (uses rclone's default), and setting it here would produce an incompatible
# crypt remote that can't decrypt production-encrypted data.
