{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Chicago",
  "schedule": ["before 8am on monday"],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate dependency dashboard",
  "labels": ["dependencies"],
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "prHourlyLimit": 0,
  "enabledManagers": ["nix", "docker-compose", "github-actions", "dockerfile"],
  "lockFileMaintenance": {
    "description": "Only flake.lock has a lockfile here: runs `nix flake update`, one PR with every input at its ref head",
    "enabled": true,
    "schedule": ["before 8am on monday"],
    "commitMessageAction": "Refresh",
    "commitMessageTopic": "flake.lock",
    "prBodyNotes": [
      "Every flake input moved to the head of its ref. CI builds all four hosts; deploy each with `make nix-deploy-host HOST=<host>` to reset its staleness clock."
    ]
  },
  "nix": {
    "enabled": true
  },
  "docker-compose": {
    "managerFilePatterns": [
      "/^hosts/containers/stacks/docker-compose\\.yml$/",
      "/^lego/docker-compose\\.yml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Tag-tracked flake inputs (none today) grouped with the lock refresh",
      "matchManagers": ["nix"],
      "groupName": "flake.lock",
      "commitMessageTopic": "flake.lock"
    },
    {
      "description": "Minor/patch image bumps grouped per weekly run; majors stay separate",
      "matchManagers": ["docker-compose", "dockerfile"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "container images"
    },
    {
      "description": "Image tags without semver (e.g. 'latest', 'stable') can't be compared; leave them alone",
      "matchManagers": ["docker-compose", "dockerfile"],
      "matchCurrentValue": "/^(latest|stable)$/",
      "enabled": false
    },
    {
      "description": "Actions pins grouped; low stakes",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
